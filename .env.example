# Copia este archivo como ".env". NUNCA subas tu ".env" real a Git.

# --- Django ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Base de datos (deja estas líneas comentadas para usar SQLite en local) ---
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=polidrive
# DB_USER=admin
# DB_PASSWORD=contraseña-de-rds
# DB_HOST=tu-instancia.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=3306

# --- S3 (deja comentado para guardar en la carpeta media/ en local) ---
# AWS_STORAGE_BUCKET_NAME=nombre-de-tu-bucket
# AWS_S3_REGION_NAME=us-east-1
# En EC2 NO pongas llaves: usa el IAM Role de la instancia.
